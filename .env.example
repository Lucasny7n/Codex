# Ailu AI Studio local development flags.
# Copy to .env.local when needed. Do not commit real credentials.

VITE_AILU_AI_PANEL_ENABLED=true
VITE_AILU_LLM_LIBRARY_ENABLED=true
VITE_AILU_DESKTOP_APP_ENABLED=true
VITE_AILU_TERMINAL_ENABLED=true
VITE_AILU_WEB_PREVIEW_ENABLED=true
VITE_AILU_EXPERIMENTAL_AGENT_TOOLS=false

# Local runtime defaults.
AILU_OLLAMA_URL=http://127.0.0.1:11434
AILU_LOCAL_MODELS_ROOT=~/.codex/models

# Cloud provider credentials must be added through the app credential flow.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=
