{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Command Center",
  "version": "0.1.0",
  "identifier": "com.lucas.codexcommandcenter",
  "mainBinaryName": "codex_command_center",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Command Center",
        "width": 1720,
        "height": 980,
        "minWidth": 1200,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "capabilities": ["default"],
      "headers": {
        "Permissions-Policy": "microphone=(self), camera=(), autoplay=(self)"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "publisher": "Lucas",
    "category": "DeveloperTool",
    "shortDescription": "Premium desktop command center for local and cloud AI models.",
    "longDescription": "Codex Command Center is a Tauri desktop app for operating local Ollama models and authenticated cloud AI providers with sessions, attachments, explicit permissions and honest runtime status.",
    "homepage": "https://github.com/Lucasny7n/Codex",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
