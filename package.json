{
  "name": "ailu-ai-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Premium AI studio for local and cloud models.",
  "author": "Lucas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lucasny7n/ailu-ai-studio.git"
  },
  "bugs": {
    "url": "https://github.com/Lucasny7n/ailu-ai-studio/issues"
  },
  "homepage": "https://github.com/Lucasny7n/ailu-ai-studio#readme",
  "keywords": [
    "ailu",
    "ai",
    "ollama",
    "llm",
    "tauri",
    "rust",
    "react",
    "typescript",
    "local-ai",
    "cloud-ai",
    "desktop-app"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:visual": "mkdir -p ${AILU_SCREENSHOT_DIR:-test-results/screenshots} && env -u NO_COLOR -u FORCE_COLOR playwright test tests/visual/ailu-ai-studio.visual.spec.ts",
    "screenshots": "mkdir -p ${AILU_SCREENSHOT_DIR:-test-results/screenshots} && env -u NO_COLOR -u FORCE_COLOR playwright test tests/visual/ailu-ai-studio.visual.spec.ts",
    "icons:generate": "bash scripts/generate-icons.sh",
    "icons:validate": "bash scripts/validate-icons.sh",
    "healthcheck": "bash scripts/healthcheck.sh",
    "doctor": "bash scripts/doctor.sh",
    "ci": "npm run lint && npm run typecheck && npm run test -- --run && npm run build",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^4.0.7"
  }
}
